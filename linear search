
#include <stdio.h>

int main()
{
    int i,n=5,key=30;
    int found=0;
    int arr[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }
    for(int i=0;i<n;i++)
    {
        if(key==arr[i])
        {
            found=1;
            printf("%d",i);
            break;
            
        }
        
    }
    if(!found)
    {
        printf("not found");
    }


    return 0;
}
